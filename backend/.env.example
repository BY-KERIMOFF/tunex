APP_NAME=Neo Radio API
APP_VERSION=1.0.0
DEBUG=false
HOST=0.0.0.0
PORT=8000
BASE_URL=https://3bneoplay65.xyz/radio

RADIO_BROWSER_MIRRORS=https://de1.api.radio-browser.info,https://nl1.api.radio-browser.info,https://at1.api.radio-browser.info,https://fi1.api.radio-browser.info
RADIO_BROWSER_PAGE_SIZE=500
RADIO_BROWSER_MAX_PAGES=100
RADIO_BROWSER_TIMEOUT=30
RADIO_BROWSER_USER_AGENT=NeoRadio/1.0

CACHE_TYPE=file
CACHE_FILE_PATH=./data/stations.json
CACHE_TTL_SECONDS=21600
REDIS_URL=redis://localhost:6379/0

GO_PROXY_HOST=127.0.0.1
GO_PROXY_PORT=8001
GO_PROXY_TIMEOUT=20
GO_PROXY_MAX_CONNECTIONS=1000

CORS_ORIGINS=*
RATE_LIMIT_PER_MINUTE=60
ADMIN_TOKEN=change_me_in_production
